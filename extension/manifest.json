{
  "manifest_version": 3,
  "name": "EVA Medical AI Copilot",
  "version": "2.3.4",
  "description": "Copiloto Radiológico Avanzado para Dalca PACS",
  "icons": {
    "16": "assets/icon128.png",
    "48": "assets/icon128.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/icon128.png",
      "48": "assets/icon128.png",
      "128": "assets/icon128.png"
    },
    "default_title": "EVA Medical AI Copilot"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.dalcapacs.com/*",
    "*://*.dalca.cl/*",
    "*://*.dalca.app/*",
    "http://127.0.0.1/*",
    "http://127.0.0.1:3000/*",
    "http://localhost/*",
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.dalcapacs.com/*",
        "*://*.dalca.cl/*",
        "*://*.dalca.app/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/icon128.png", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}